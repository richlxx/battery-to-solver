FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     dfnFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         4000;

deltaT          1;

writeControl    runTime;
writeInterval   600;

purgeWrite      0;

writeFormat     ascii;
writePrecision  10;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;
